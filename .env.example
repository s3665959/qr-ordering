# Copy this file to .env and replace every placeholder before running MySQL.
MYSQL_DATABASE=shabu_buffet
MYSQL_USER=shabu_app
MYSQL_PASSWORD=replace_with_a_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_root_password
MYSQL_PORT=3306
MYSQL_BIND_ADDRESS=127.0.0.1

DATABASE_URL="mysql://shabu_app:replace_with_a_local_password@127.0.0.1:3306/shabu_buffet"
AUTH_SESSION_SECRET=replace_with_at_least_32_random_bytes
QR_TOKEN_PEPPER=replace_with_at_least_32_random_bytes
NEXT_PUBLIC_APP_URL=https://qr-order.811544.xyz

# Integration tests use a separate local database; see .env.test.example.

# Current implementation stores only URL/path keys; it does not upload binary
# files and does not implement S3 or another object-storage provider.
IMAGE_STORAGE_DRIVER=local
LOCAL_IMAGE_STORAGE_PATH=./storage/uploads
PUBLIC_IMAGE_BASE_URL=https://qr-order.811544.xyz/uploads
